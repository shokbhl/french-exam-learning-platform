# Public application URL used for authentication callbacks and canonical links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anonymous-public-key

# Server-only. Required for trusted background ingestion/admin jobs; never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Replace with a PostgreSQL connection string in deployed environments.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/french_exam_platform

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-value

# Optional AI feedback provider. Never put a real key in this template.
OPENAI_API_KEY=your-api-key-here

# Optional provider selectors; the application remains usable when unset.
AI_PROVIDER=disabled
SPEECH_TO_TEXT_PROVIDER=disabled
TEXT_TO_SPEECH_PROVIDER=disabled
